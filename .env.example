# ──────────────────────────────────────────────────────────────────────────────
# AI-SecureScan — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Your Groq API key. Get it FREE from: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-key-here

# ── Model Configuration ───────────────────────────────────────────────────────
# Supported: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
MODEL=llama-3.3-70b-versatile

# ── Safety ────────────────────────────────────────────────────────────────────
# SAFE_MODE=true  → No real nmap execution. Uses mock scan output.
# SAFE_MODE=false → Executes real nmap scans. Requires nmap installed.
# IMPORTANT: Only set to false on systems you own or have written authorization to scan.
SAFE_MODE=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Timeouts ──────────────────────────────────────────────────────────────────
# Maximum seconds to wait for Groq API responses
REQUEST_TIMEOUT=60
