# ──────────────────────────────────────────────────────────────────────────────
# AI-SecureScan — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Your OpenAI API key. Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ── Model Configuration ───────────────────────────────────────────────────────
# Supported: gpt-4o-mini (fast/cheap), gpt-4o (best quality), gpt-3.5-turbo
MODEL=gpt-4o-mini

# ── Safety ────────────────────────────────────────────────────────────────────
# SAFE_MODE=true  → No real nmap execution. Uses mock scan output.
# SAFE_MODE=false → Executes real nmap scans. Requires nmap installed.
# IMPORTANT: Only set to false on systems you own or have written authorization to scan.
SAFE_MODE=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Timeouts ──────────────────────────────────────────────────────────────────
# Maximum seconds to wait for OpenAI API responses
REQUEST_TIMEOUT=60
